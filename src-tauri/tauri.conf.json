{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "resonance-chat",
    "version": "1.0.1",
    "identifier": "com.resonance-chat",
    "build": {
        "beforeDevCommand": "npm run dev",
        "beforeBuildCommand": "npm run build",
        "devUrl": "http://localhost:1421",
        "frontendDist": "../build"
    },
    "app": {
        "windows": [
            {
                "title": "Resonance Chat",
                "label": "main",
                "width": 520,
                "height": 600,
                "minWidth": 320,
                "minHeight": 200,
                "alwaysOnTop": true,
                "transparent": true
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": ["icons/icon.ico", "icons/icon.icns", "icons/32x32.png", "icons/128x128.png"],
        "resources": [
            "./WinDivert.dll",
            "./WinDivert64.sys"
        ],
        "windows": {
            "webviewInstallMode": { "type": "downloadBootstrapper" }
        }
    }
}
